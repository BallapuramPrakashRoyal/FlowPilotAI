# FlowPilot AI — Production Environment Configuration (.env.production)

# Database Credentials (PostgreSQL 17 with pgvector)
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=replace_with_strong_production_database_password_min_32_chars
POSTGRES_DB=flowpilot_db
DATABASE_URL=postgresql+asyncpg://flowpilot:replace_with_strong_production_database_password_min_32_chars@postgres:5432/flowpilot_db
SYNC_DATABASE_URL=postgresql://flowpilot:replace_with_strong_production_database_password_min_32_chars@postgres:5432/flowpilot_db

# Redis Broker (Celery & Caching)
REDIS_URL=redis://redis:6379/0

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_cryptographically_secure_random_jwt_secret_key_32_bytes
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_fernet_aes_256_symmetric_key==

# Google OAuth 2.0 Integration (Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/gmail/callback

# AI Provider Configurations
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com
